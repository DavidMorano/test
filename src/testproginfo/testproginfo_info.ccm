export {
    enum infomems {
	infomem_start,
	infomem_finish,
	infomem_overlast
    } ; /* end enum (infomems) */
    struct maininfo ;
    struct maininfo_co {
	 maininfo	*op ;
	 int		w ;
	 void operator () (maininfo *p,int ªw) noex {
	     op = p ;
	     w = ªw ;
	 } ; /* end method */
	 operator int () noex ;
	 int operator () (mainv) noex ;
    } ; /* end struct (maininfo_co) */
    struct maininfo : proginfo {
	friend		maininfo_co ;
	maininfo_co	start ;
	maininfo_co	finish ;
	maininfo(int ac,con mainv av,con mainv ev) noex {
	    args	(ac,av,ev) ;
	    start	(this,infomem_start) ;
	    finish	(this,infomem_finish) ;
	} ; /* end ctor */
	operator int	() noex ;
    private:
	int pstart	(mainv = nullptr) noex ;
	int pfinish	() noex ;
    } ; /* end struct (maininfo) */
} /* end export */


